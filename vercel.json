{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "https://picodesign.fr/jml",
      "permanent": true
    },
    {
      "source": "/:path+",
      "destination": "https://picodesign.fr/jml/:path+",
      "permanent": true
    }
  ]
}
